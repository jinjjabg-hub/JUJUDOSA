rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 계정 문서 (등급·사용 횟수·구독 신청) =====
    // 등급(tier)은 관리자만 Firebase 콘솔에서 변경. 고객은 사용 횟수를 줄이거나 초기화할 수 없음.
    match /users/{userId} {
      function isOwner() { return request.auth != null && request.auth.uid == userId; }
      function oldData() { return resource == null ? {} : resource.data; }
      function newData() { return request.resource.data; }
      function todayUTC() {
        let t = request.time;
        return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month())
          + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
      }
      function tierUnchanged() {
        return newData().get('tier', 'free') == oldData().get('tier', 'free');
      }
      function chatUsedOk() {
        return newData().get('chatUsed', 0) >= oldData().get('chatUsed', 0);
      }
      function dailyOk() {
        let oldD = oldData().get('dailyDate', '');
        let newD = newData().get('dailyDate', '');
        return newD == oldD
          ? newData().get('dailyCount', 0) >= oldData().get('dailyCount', 0)
          : newD == todayUTC();
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && tierUnchanged() && chatUsedOk() && dailyOk();
      allow delete: if false;
    }

    match /users/{userId}/profiles/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 정밀 MBTI 진행상황 (본인만)
      match /mbtiProgress/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ===== 귀인지도 =====
    match /users/{userId}/gwiinMaps/{mapId} {
      // 지도 자체: 읽기는 누구나(공유 링크용), 쓰기는 지도 주인만
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      // 참여자: 로그인 없이 추가만 가능. 수정 불가, 삭제는 지도 주인만.
      match /entries/{entryId} {
        allow read: if true;

        allow create: if
          request.resource.data.keys().hasAll(['name','bdate','calType','relKey','relName','score','element','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 12
          && request.resource.data.bdate is string
          && request.resource.data.bdate.size() <= 12
          && request.resource.data.calType in ['solar','lunar']
          && request.resource.data.relKey in ['gwiin','chaejjik','jjakkung','naesaram','jorak']
          && request.resource.data.relName is string
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100
          && request.resource.data.element is int
          && request.resource.data.element >= 0
          && request.resource.data.element <= 4
          && exists(/databases/$(database)/documents/users/$(userId)/gwiinMaps/$(mapId));

        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
